# KREAM 로그인 이메일/비밀번호.
# 크롬 프로필(auth/chrome_profile_kream)에 로그인이 남아 있으면 쓰지 않는다.
# 세션이 끊겼을 때만 이 값으로 자동 로그인한다. 비워두면 크롬 창에서 직접 로그인할 때까지 기다린다.
KREAM_ID=
KREAM_PW=

# 최근 며칠간의 체결 내역을 볼지 / 그 기간 빠른배송 체결이 몇 건 이상이어야 사는지
LOOKBACK_DAYS=30
MIN_FAST_SALES=15

# (A - B) 가 A 의 몇 % 를 넘어야 입찰하는지 (0.10 = 10%).
# GUI 의 [입찰 기준] 표에서 A 금액 구간별 마진율과 상품 금액 상한을 정해 두면 (data/bid_rules.json)
# 그 파일이 우선이고, 이 값은 그 파일이 없을 때만 쓴다.
MIN_MARGIN_RATE=0.10

# 입찰 마감기한(일). 화면의 1/3/7/30/60/90/180 중 하나
BID_DAYS=7

# 랭킹(검색어, SHOP 카테고리)마다 몇 개 상품까지 볼지 (GUI 의 상품 수 칸 기본값)
MAX_PRODUCTS=30

# [입찰] 검색 모드에서 검색 결과에 '빠른배송' 필터를 걸어 빠른배송 판매자가 있는 상품만 볼지 (1, 기본).
# 판매자가 없는 상품은 A 를 못 읽어 어차피 건너뛰므로 켜 두면 스로틀 대상 요청을 아낀다. GUI 체크 / --no-quick-filter 로도 바꿀 수 있다
SEARCH_QUICK_ONLY=1

# [입찰] SHOP 모드에서 카테고리 목록에 같은 '빠른배송' 필터를 걸지 (1, 기본). GUI 체크 / --no-quick-filter 로도 바꿀 수 있다
SHOP_QUICK_ONLY=1

# 엑셀 보고서 저장 폴더 (비우면 바탕화면\KREAM 결과)
REPORT_DIR=

# 이미지/동영상/폰트를 받지 않아 빨리 동작한다 (1). 크롬 화면에 그림까지 보고 싶으면 0
BLOCK_IMAGES=1

# 크롬 창을 화면에 보이게 둘지 (1). 기본(0)은 창을 모니터 바깥에 두고 GUI 상태창으로만 진행을 본다.
# 직접 로그인이 필요할 때는 자동으로 불러온다.
SHOW_CHROME=0

# 시세 API(상품 상세) 조회 간격(초) - [재입찰]은 입찰 하나에 호출 하나라 이 값이 곧 속도이고 회차 사이에 따로 쉬지 않는다.
# [입찰]은 상품 하나에 호출 하나로 가격을 먼저 거른다. 기본 6초 (README '사이트 스로틀' 6 - 시간당 600건, 실측상 안 막힌 수준).
# 3~60초. 3초는 실측 밖이라 근거 없이 내리지 말 것. 차단 신호(무응답·5xx)를 맞으면 프로그램이 알아서 두 배씩 늘렸다 되돌린다.
# GUI 의 "시세 조회 간격" 칸으로도 바꿀 수 있다
API_TICK_SEC=6

# 접속 예산 - kream.co.kr 페이지 이동을 10분에 이만큼까지만, 창 안에 고르게 나눠 쓴다 (README '사이트 스로틀' 5).
# 실측상 막히지 않은 최대가 100. 더 올리면 막힐 수 있고 막히면 5분 이상 멈춘다. 0 이면 세지 않는다
PAGE_BUDGET_PER_10MIN=100

# [재입찰] 몇 사이클(구매 입찰 목록 몇 바퀴) 돌고 끝낼지. GUI 의 "재입찰 횟수" 칸 기본값이고 실행할 때마다 칸에서 바꿀 수 있다.
# 0 이면 [중지]/Ctrl+C 를 누를 때까지 계속 돈다. 명령행은 --cycles / --once
REBID_CYCLES=1
