# KREAM 로그인 이메일/비밀번호.
# 크롬 프로필(auth/chrome_profile_kream)에 로그인이 남아 있으면 쓰지 않는다.
# 세션이 끊겼을 때만 이 값으로 자동 로그인한다. 비워두면 크롬 창에서 직접 로그인할 때까지 기다린다.
KREAM_ID=
KREAM_PW=

# 최근 며칠간의 체결 내역을 볼지 / 그 기간 빠른배송 체결이 몇 건 이상이어야 사는지
LOOKBACK_DAYS=30
MIN_FAST_SALES=15

# (A - B) 가 A 의 몇 % 를 넘어야 입찰하는지 (0.10 = 10%)
MIN_MARGIN_RATE=0.10

# 입찰 마감기한(일). 화면의 1/3/7/30/60/90/180 중 하나
BID_DAYS=7

# 랭킹에서 몇 개 상품까지 볼지
MAX_PRODUCTS=30

# 엑셀 보고서 저장 폴더 (비우면 바탕화면\KREAM 결과)
REPORT_DIR=
